# TinyFish API Key (Required for monitor, fetch, agent, browser)
TINYFISH_API_KEY=your_tinyfish_api_key_here

# Groq API Key (Required for LLM semantic classification and extraction)
GROQ_API_KEY=your_groq_api_key_here

# Supabase Credentials (Required for cloud persistence and storage)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key_here

# Time Machine Webhook Configuration
WEBHOOK_URL=https://your-domain.onrender.com/webhook
WEBHOOK_SECRET=your_random_webhook_secret_here

# Administration and Mutation Security
ADMIN_TOKEN=your_secure_admin_token_here
WAKE_SECRET=your_processor_wake_secret_here

# Storage Backend ('sqlite' for local dev, 'supabase' for cloud production)
STORE_BACKEND=sqlite

# Environment ('development' or 'production')
ENV=development
